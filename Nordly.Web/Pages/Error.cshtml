@page
@model ErrorModel
@{
    ViewData["Title"] = "Noe gikk galt";
}

<div class="info-page error-page">
    <span class="eyebrow">Beklager</span>
    <h1>Noe gikk galt</h1>
    <p class="info-lead">Vi klarte ikke å fullføre forespørselen akkurat nå. Prøv igjen om litt, eller ta kontakt med oss hvis problemet fortsetter.</p>

    @if (Model.ShowRequestId)
    {
        <p class="error-reference">Referanse: <code>@Model.RequestId</code></p>
    }

    <div class="error-page-actions">
        <a class="primary-btn" asp-page="/Index">Tilbake til butikken <span aria-hidden="true">→</span></a>
        <a class="text-link" asp-page="/Info/Support">Kontakt kundeservice</a>
    </div>
</div>
