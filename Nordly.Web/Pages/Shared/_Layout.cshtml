<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NORDLY</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..800&family=Fraunces:ital,wght@0,400;1,400&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="announcement-bar">Fri frakt på ordre fra 800 kr <span class="announcement-dot">•</span><span class="announcement-extra">Levering på 2–4 virkedager</span></div>
    @{
        var cartCount = Nordly.Web.Cart.Load(Context.Session).Count;
    }
    <header class="topbar">
        <a class="brand" asp-page="/Index">NORDLY <span>STUDIO</span></a>
        <nav class="nav-links" aria-label="Hovedmeny" id="main-navigation">
            <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index">Butikk</a>
            <a class="nav-optional" href="/#collection" data-product-filter="all">Kolleksjon</a>
            <a class="nav-optional" href="/#new-arrivals" data-product-filter="new">Nyheter</a>
            <a class="nav-optional" href="/#offers" data-product-filter="sale">Tilbud</a>
            <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Cart" ? "active" : "")" asp-page="/Cart">Handlekurv <span class="nav-badge">@cartCount</span></a>
        </nav>
        <div class="mobile-nav-actions">
            <a class="mobile-search-link" href="/#product-search"><span aria-hidden="true">⌕</span><span>Søk</span></a>
            <a class="mobile-cart-link" asp-page="/Cart" aria-label="Gå til handlekurven, @cartCount varer i kurven">
            <span class="mobile-cart-icon" aria-hidden="true">Kurv</span>
            <span class="nav-badge">@cartCount</span>
            </a>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-brand"><strong>NORDLY</strong><span>Ting for hverdagen.</span></div>
        <div class="footer-links"><a asp-page="/Info/Delivery">Levering & retur</a><a asp-page="/Info/Faq">Vanlige spørsmål</a><a asp-page="/Info/Support">Kundeservice</a><a asp-page="/Privacy">Personvern</a><a asp-page="/Info/Terms">Vilkår</a></div>
        <div class="footer-payment"><span>Trygg betaling</span><strong>Stripe · Visa · Mastercard</strong></div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>