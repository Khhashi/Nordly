@page
@model IndexModel
@{
	ViewData["Title"] = "Butikk";
	var hero = Model.Products[0];
	string TileImage(string category) => Model.Products.First(product => product.Category == category).ImageUrl;
}

<div class="store-shell">
	<section class="store-hero">
		<div>
			<span class="eyebrow">Norsk design til hverdagen</span>
			<h1>Færre ting.<br /><em>Mer kvalitet.</em></h1>
			<p>Praktiske, vakre produkter som gjør det enklere å bo, jobbe og leve godt.</p>
			<div class="hero-actions">
				<a class="hero-primary" href="#collection" data-product-filter="all">Se kolleksjonen <span aria-hidden="true">→</span></a>
				<a class="hero-secondary" href="#new-arrivals" data-product-filter="new">Nyheter</a>
			</div>
		</div>
		<figure class="hero-visual">
			<img src="@hero.ImageUrl" alt="@hero.Name" fetchpriority="high" />
			<a class="hero-product" asp-page="/Products/Details" asp-route-id="@hero.Id">
				<span>Ukens favoritt</span>
				<strong>@hero.Name · @hero.Price.ToString("N0") kr <span aria-hidden="true">→</span></strong>
			</a>
		</figure>
	</section>

	<div class="benefit-strip" aria-label="Kundefordeler">
		<div><strong>01</strong><span>Små serier<br />med omtanke</span></div>
		<div><strong>02</strong><span>14 dagers<br />retur</span></div>
		<div><strong>03</strong><span>Rask levering<br />i Norge</span></div>
	</div>

	<section id="offers" class="category-showcase" aria-label="Handle etter kategori">
		<div class="section-intro">
			<span class="section-kicker">For hverdagen</span>
			<h2>Start med det du trenger.</h2>
			<p>Enkel, praktisk og godt gjennomtenkt.</p>
		</div>
		<div class="category-tiles">
			<a class="category-tile" href="#collection" data-category-link="Kjøkken">
				<img src="@TileImage("Kjøkken")" alt="" loading="lazy" />
				<span class="tile-label">Kjøkken</span>
				<strong>For rolige morgener</strong>
				<span class="tile-arrow" aria-hidden="true">↗</span>
			</a>
			<a class="category-tile" href="#collection" data-category-link="Kontor">
				<img src="@TileImage("Kontor")" alt="" loading="lazy" />
				<span class="tile-label">Arbeidsplass</span>
				<strong>Mer ro, mer fokus</strong>
				<span class="tile-arrow" aria-hidden="true">↗</span>
			</a>
			<a class="category-tile" href="#collection" data-category-link="Hjem">
				<img src="@TileImage("Hjem")" alt="" loading="lazy" />
				<span class="tile-label">Hjem</span>
				<strong>Et lunere hjem</strong>
				<span class="tile-arrow" aria-hidden="true">↗</span>
			</a>
		</div>
	</section>

	@if (TempData["Success"] is string success)
	{
		<div class="alert alert-success action-toast" role="status"><span class="feedback-icon" aria-hidden="true">✓</span><span>@success</span><button class="toast-close" type="button" aria-label="Lukk melding">×</button></div>
	}

	<div id="new-arrivals" class="catalog-header">
		<div>
			<span class="section-kicker">Utvalgt for deg</span>
			<h2>Utvalgte produkter</h2>
		</div>
		<div class="catalog-tools">
			<div class="search-field-wrap" id="catalog-search">
				<label class="search-field"><span aria-hidden="true">⌕</span><input id="product-search" type="search" placeholder="Søk i sortimentet" aria-label="Søk i produkter" autocomplete="off" aria-autocomplete="list" aria-controls="product-suggestions" aria-expanded="false" /></label>
				<ul id="product-suggestions" class="product-suggestions" role="listbox" aria-label="Produktforslag" hidden></ul>
			</div>
			<label class="catalog-sort-label" for="product-sort">Sorter</label>
			<select id="product-sort" class="catalog-sort" aria-label="Sorter produkter">
				<option value="default">Anbefalt</option>
				<option value="price-ascending">Pris: lav til høy</option>
				<option value="price-descending">Pris: høy til lav</option>
			</select>
			<span class="catalog-count">@Model.Products.Count varer</span>
		</div>
	</div>
	<div class="category-tabs" role="tablist" aria-label="Produktkategorier">
		<button class="category-tab active" type="button" data-category="all">Alle</button>
		@foreach (var category in Model.Products.Select(product => product.Category).Distinct())
		{
			<button class="category-tab" type="button" data-category="@category">@category</button>
		}
	</div>

	<section id="collection" class="product-grid" aria-label="Produktkatalog">
		@foreach (var product in Model.Products)
		{
			<article class="product-card" data-price="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-category="@product.Category" data-badge="@product.Badge" data-sale="@(product.OriginalPrice is not null ? "true" : "false")" data-search="@product.Name @product.Description">
				<div class="product-image-wrap">
					<a asp-page="/Products/Details" asp-route-id="@product.Id" aria-label="Se detaljer for @product.Name"><img class="product-image" src="@product.ImageUrl" alt="@product.Name" loading="lazy" decoding="async" /></a>
					<span class="product-category">@product.Category</span>
					@if (product.Badge is not null)
					{
						<span class="product-badge">@product.Badge</span>
					}
				</div>
				<div class="product-info">
					<div>
						<h3><a asp-page="/Products/Details" asp-route-id="@product.Id">@product.Name</a></h3>
						<p>@product.Description</p>
						<a class="product-detail-link" asp-page="/Products/Details" asp-route-id="@product.Id">Se produkt <span aria-hidden="true">→</span></a>
					</div>
					<div class="product-buy-row">
						<div class="price-stack" role="group" aria-label="@(product.OriginalPrice is not null ? $"Nåpris {product.Price:N0} kroner, førpris {product.OriginalPrice.Value:N0} kroner" : $"Pris {product.Price:N0} kroner")"><strong><span class="visually-hidden">Nåpris </span>@product.Price.ToString("N0") kr</strong>@if (product.OriginalPrice is not null) { <del><span class="visually-hidden">Førpris </span>@product.OriginalPrice.Value.ToString("N0") kr</del> }</div>
						@{
							var quantity = Model.ProductQuantities.GetValueOrDefault(product.Id);
						}
						<div class="quantity-control product-card-quantity @(quantity > 0 ? "has-quantity" : "")" aria-label="Antall @product.Name">
							<form class="cart-quantity-form remove-form" method="post" asp-page-handler="RemoveFromCart" hidden="@(quantity == 0 ? "hidden" : null)">
								<input type="hidden" name="productId" value="@product.Id" />
								<button class="quantity-btn remove-btn" type="submit" aria-label="Fjern én @product.Name">−</button>
							</form>
							<span class="quantity-value" aria-live="polite" hidden="@(quantity == 0 ? "hidden" : null)">@quantity</span>
							<form class="cart-quantity-form add-form" method="post" asp-page-handler="AddToCart">
								<input type="hidden" name="productId" value="@product.Id" />
								<button class="quantity-btn add-btn" type="submit" aria-label="Legg én @product.Name i handlekurven"><span class="product-add-icon" aria-hidden="true">+</span><span class="product-add-label" aria-hidden="true">Legg i kurv</span></button>
							</form>
						</div>
					</div>
				</div>
			</article>
		}
	</section>
	<div class="no-results" role="status" hidden>
		<p>Vi fant ingen produkter som passer søket og filtrene dine.</p>
		<button class="text-link reset-catalog" type="button">Nullstill søk og filtre</button>
	</div>

	<section class="service-grid" aria-label="NORDLY tjenester">
		<div class="service-card"><span class="service-icon">✦</span><h3>Fri frakt fra 800 kr</h3><p>Vi pakker ordren din med omtanke og sender den raskt.</p></div>
		<div class="service-card"><span class="service-icon">↺</span><h3>14 dagers retur</h3><p>Prøv hjemmet før du bestemmer deg. Enkelt og trygt.</p></div>
		<div class="service-card"><span class="service-icon">♡</span><h3>Hjelp fra mennesker</h3><p>Spør oss om produkter, gaver eller hva som passer deg.</p></div>
	</section>

	<section class="editorial-panel">
		<div class="editorial-image"></div>
		<div class="editorial-copy">
			<span class="eyebrow">Om oss</span>
			<h2>Vi velger ting som blir brukt.</h2>
			<p>Vi samler produkter vi selv vil ha i hjemmet: praktiske, rolige og godt designede ting som gjør hverdagen litt enklere.</p>
			<a class="text-link" asp-page="/About">Les mer her <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section id="newsletter" class="newsletter-panel">
		<div><span class="section-kicker">Nyhetsbrev</span><h2>Gode ting, sendt<br />med omtanke.</h2></div>
		<div>
			<p>Få nyheter om nye produkter, gode tips og utvalgte favoritter.</p>
			<form class="newsletter-form" method="post" asp-page-handler="SubscribeNewsletter">
				<input type="email" name="email" placeholder="Din e-postadresse" aria-label="Din e-postadresse" autocomplete="email" required />
				<button type="submit">Meld meg på</button>
			</form>
			@if (TempData["NewsletterSuccess"] is string newsletterSuccess)
			{
				<p class="newsletter-message newsletter-success" role="status">✓ @newsletterSuccess</p>
			}
			else if (TempData["NewsletterError"] is string newsletterError)
			{
				<p class="newsletter-message newsletter-error" role="alert">@newsletterError</p>
			}
			else
			{
				<small>Ingen spam. Bare det vi faktisk vil dele.</small>
			}
		</div>
	</section>
</div>
