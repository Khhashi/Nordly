@page
@model SuccessModel
@{
    ViewData["Title"] = "Bestillingen er bekreftet";
}

<div class="success-shell">
    <div class="success-mark">✓</div>
    <span class="eyebrow">Betaling fullført</span>
    <h1>Takk for bestillingen.</h1>
    <p>Betalingen er bekreftet, og vi gjør pakken klar med en gang.</p>
    @if (Model.FormattedOrderNumber is string orderNumber)
    {
        <span class="confirmation-code">Ordre @orderNumber</span>
    }
    <a class="primary-btn" asp-page="/Index">Tilbake til butikken <span aria-hidden="true">→</span></a>
</div>