@page
@{
    ViewData["Title"] = "Vilkår";
    ViewData["PageMetadata"] = PageMetadataBuilder.Create(Configuration["PublicBaseUrl"], "Demonstrasjon – NORDLY", "NORDLY er en portefølje- og testdemo, ikke en faktisk nettbutikk.", "/Info/Terms");
}

<div class="info-page">
    <span class="eyebrow">Godt å vite</span>
    <h1>Kun en demonstrasjon</h1>
    <div class="info-content">
        <p>NORDLY er en portefølje- og testdemo, ikke en faktisk nettbutikk. Produktnavn, beskrivelser, priser, tilbud, leveringsopplysninger og returtekster er eksempler og utgjør ikke et tilbud om kjøp.</p>
        <p>Checkout bruker kun Stripe testmodus. Ingen ekte betalinger gjennomføres, varer sendes ikke, og det skal ikke oppgis reelle person- eller kortopplysninger.</p>
    </div>
</div>