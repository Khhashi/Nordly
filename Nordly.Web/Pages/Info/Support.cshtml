@page
@{
    ViewData["Title"] = "Kundeservice";
    ViewData["PageMetadata"] = PageMetadataBuilder.Create(Configuration["PublicBaseUrl"], "Kundeservice – NORDLY", "Ta kontakt med NORDLY hvis du har spørsmål om produkter, bestilling, betaling, levering eller retur.", "/Info/Support");
}

<div class="info-page">
    <span class="eyebrow">Vi er her for å hjelpe</span>
    <h1>Hvordan kan vi hjelpe?</h1>
    <p class="info-lead">Har du spørsmål om produkter, levering eller retur? Vi svarer så raskt vi kan.</p>
    <p><a class="text-link" asp-page="/Info/Faq">Se vanlige spørsmål →</a></p>
    <div class="support-card"><strong>hello@nordly.studio</strong><span>Mandag–fredag · 09:00–16:00</span><a class="text-link" href="mailto:hello@nordly.studio">Send oss en e-post →</a></div>
</div>