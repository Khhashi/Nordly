@page
@{
    ViewData["Title"] = "Levering og retur";
    ViewData["PageMetadata"] = PageMetadataBuilder.Create(Configuration["PublicBaseUrl"], "Levering og retur – NORDLY demo", "Eksempler på frakt og retur i NORDLY-demoen. Ingen varer selges, sendes eller returneres.", "/Info/Delivery");
}

<div class="info-page">
    <span class="eyebrow">Praktisk info</span>
    <h1>Levering & retur</h1>
    <p class="info-lead" role="note">Dette er en demo. Ingen varer selges, sendes eller returneres. Tidene og beløpene under er kun eksempler.</p>
    <div class="info-content">
        <h2>Eksempel på levering</h2>
        <p>Demoen viser levering innen én virkedag og normal leveringstid på 2–4 virkedager. Vi sender ikke varer.</p>
        <h2>Eksempel på frakt</h2>
        <p>Handlekurven viser fri frakt fra 800 kr og standard frakt på 79 kr. Beløpene er bare eksempler.</p>
        <h2>Retur</h2>
        <p>14 dagers retur er kun et eksempel på en butikkpolicy. Varer fra demoen kan ikke returneres.</p>
    </div>
</div>