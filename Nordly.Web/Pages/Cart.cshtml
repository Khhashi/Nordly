@page
@model CartModel
@{
    ViewData["Title"] = "Handlekurv";
}

<div class="store-shell">
    <div class="store-heading compact-heading">
        <div>
            <span class="eyebrow">Ditt utvalg</span>
            <h1>Handlekurv</h1>
        </div>
        <a class="text-link" asp-page="/Index">Fortsett å handle <span aria-hidden="true">→</span></a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success action-toast" role="status"><span class="feedback-icon" aria-hidden="true">✓</span><span>@success</span><button class="toast-close" type="button" aria-label="Lukk melding">×</button></div>
    }

    @if (!Model.Items.Any())
    {
        <section class="empty-cart">
            <span class="empty-mark">＋</span>
            <h2>Handlekurven er tom</h2>
            <p>Finn noe du liker og legg det til her.</p>
            <a class="primary-btn" asp-page="/Index">Se produkter <span aria-hidden="true">→</span></a>
        </section>
        <section class="empty-cart-recommendations" aria-labelledby="empty-cart-recommendations-title">
            <div class="section-intro">
                <span class="section-kicker">Utvalgt for deg</span>
                <h2 id="empty-cart-recommendations-title">Kanskje du liker disse</h2>
            </div>
            <div class="product-grid empty-cart-product-grid">
                @foreach (var product in Model.SuggestedProducts)
                {
                    <article class="product-card">
                        <div class="product-image-wrap">
                            <a asp-page="/Products/Details" asp-route-id="@product.Id" aria-label="Se detaljer for @product.Name">
                                <img class="product-image" src="@product.ImageUrl" alt="@product.Name" loading="lazy" decoding="async" />
                            </a>
                            <span class="product-category">@product.Category</span>
                        </div>
                        <div class="product-info">
                            <h3><a asp-page="/Products/Details" asp-route-id="@product.Id">@product.Name</a></h3>
                            <p>@product.Description</p>
                            <div class="product-buy-row">
                                <strong>@product.Price.ToString("N0") kr</strong>
                                <form method="post" asp-page-handler="AddSuggestedProduct">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button class="empty-cart-add" type="submit" aria-label="Legg @product.Name i handlekurven">Legg i kurv</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    else
    {
        <section class="free-shipping-progress" aria-label="Fremdrift mot gratis levering">
            @if (Model.HasFreeShipping)
            {
                <p class="free-shipping-message" role="status">Du har nådd grensen for gratis levering!</p>
            }
            else
            {
                <p class="free-shipping-message" role="status">Handle for <strong>@Model.AmountUntilFreeShipping.ToString("N0") kr</strong> til for å få gratis levering.</p>
            }
            <div class="free-shipping-track" role="progressbar" aria-label="Fremdrift mot gratis levering" aria-valuemin="0" aria-valuemax="@Model.FreeShippingThreshold.ToString("0")" aria-valuenow="@Model.FreeShippingProgressValue.ToString("0")" aria-valuetext="@(Model.HasFreeShipping ? "Gratis levering oppnådd" : $"{Model.FreeShippingProgressPercent} prosent")">
                <span class="free-shipping-fill" style="width: @Model.FreeShippingProgressPercent%"></span>
            </div>
            <div class="free-shipping-labels"><span>0 kr</span><span>Gratis levering fra @Model.FreeShippingThreshold.ToString("N0") kr</span></div>
        </section>

        <div class="cart-layout">
            <section class="cart-items">
                @foreach (var item in Model.Items)
                {
                    <article class="cart-item">
                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" />
                        <div class="cart-item-copy">
                            <span class="section-kicker">@item.Product.Category</span>
                            <h2>@item.Product.Name</h2>
                            @if (item.Product.IsOnSale)
                            {
                                <div class="cart-price-stack" role="group" aria-label="Nåpris @item.Product.Price.ToString("N0") kroner per stykk, førpris @item.Product.OriginalPrice!.Value.ToString("N0") kroner per stykk">
                                    <del><span class="visually-hidden">Førpris </span>@item.Product.OriginalPrice!.Value.ToString("N0") kr per stykk</del>
                                    <strong><span class="visually-hidden">Nåpris </span>@item.Product.Price.ToString("N0") kr per stykk</strong>
                                </div>
                                <span class="sale-savings">Du sparer @((item.Product.Savings * item.Quantity).ToString("N0")) kr totalt</span>
                            }
                            else
                            {
                                <p>@item.Product.Price.ToString("N0") kr per stykk</p>
                            }
                        </div>
                        <div class="quantity-stepper" aria-label="Antall @item.Product.Name">
                            <form method="post" asp-page-handler="Decrease"><input type="hidden" name="productId" value="@item.Product.Id" /><button type="submit" aria-label="Mink antall">−</button></form>
                            <span>@item.Quantity</span>
                            <form method="post" asp-page-handler="Increase"><input type="hidden" name="productId" value="@item.Product.Id" /><button type="submit" aria-label="Øk antall">+</button></form>
                        </div>
                        <div class="cart-item-total" aria-label="Linjesum nåpris @((item.Product.Price * item.Quantity).ToString("N0")) kroner">@((item.Product.Price * item.Quantity).ToString("N0")) kr</div>
                        <form method="post" asp-page-handler="Remove"><input type="hidden" name="productId" value="@item.Product.Id" /><button class="remove-item" type="submit">Fjern</button></form>
                    </article>
                }
            </section>
            <aside class="checkout-panel">
                <span class="section-kicker">Oppsummering</span>
                <h2>Din ordre</h2>
                <div class="summary-row"><span>Produkter</span><span>@Model.Items.Sum(item => item.Quantity)</span></div>
                <div class="summary-row"><span>@Model.ShippingLabel</span><span>@(Model.ShippingCost == 0 ? "Gratis" : $"{Model.ShippingCost:N0} kr")</span></div>
                <div class="summary-total"><span>Totalt</span><strong>@Model.GrandTotal.ToString("N0") kr</strong></div>
                @if (Model.StripeConfigured)
                {
                    <form method="post" asp-page-handler="Checkout">
                        <button class="primary-btn" type="submit">Betal trygt med Stripe <span aria-hidden="true">→</span></button>
                    </form>
                    <small class="secure-note">Kortinformasjonen behandles sikkert av Stripe.</small>
                }
                else
                {
                    <div class="checkout-coming-soon">
                        <span class="checkout-status-dot"></span>
                        <div><strong>Betaling kommer snart</strong><small>Vi gjør klar sikker kortbetaling for deg.</small></div>
                    </div>
                    <small class="secure-note">Ordren kan forhåndsvises nå. Stripe aktiveres i produksjonsmiljøet.</small>
                }
            </aside>
        </div>
    }
</div>