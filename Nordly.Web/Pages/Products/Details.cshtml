@page "{id:guid}"
@model DetailsModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Produkt";
}

@if (Model.Product is not null)
{
    <div class="product-detail-shell">
        <nav class="breadcrumb" aria-label="Brødsmulesti">
            <a asp-page="/Index">Butikk</a><span>/</span><span>@Model.Product.Category</span><span>/</span><strong>@Model.Product.Name</strong>
        </nav>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success action-toast" role="status"><span class="feedback-icon" aria-hidden="true">✓</span><span>@success</span><button class="toast-close" type="button" aria-label="Lukk melding">×</button></div>
        }

        <section class="product-detail-grid">
            <div class="detail-image-panel">
                <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" />
                <span class="detail-image-label">Studio collection / @Model.Product.Category</span>
            </div>
            <div class="product-detail-copy">
                <span class="eyebrow">@Model.Product.Category · Studio collection</span>
                <h1>@Model.Product.Name</h1>
                <p class="detail-price">@Model.Product.Price.ToString("N0") kr</p>
                <p class="detail-description">@Model.Product.Description Et gjennomtenkt objekt med en taktil finish og funksjon som holder over tid.</p>

                <form method="post" asp-page-handler="AddToCart" class="detail-buy-form" id="detail-buy-form">
                    <div class="quantity-control detail-stepper" role="group" aria-label="Antall">
                        <button class="quantity-btn remove-btn" type="button" data-step="-1" aria-label="Færre">−</button>
                        <input id="quantity" name="quantity" type="number" min="1" max="10" value="1" inputmode="numeric" aria-label="Antall" />
                        <button class="quantity-btn add-btn" type="button" data-step="1" aria-label="Flere">+</button>
                    </div>
                    <button class="primary-btn" type="submit">Legg i handlekurv <span aria-hidden="true">→</span></button>
                </form>

                <div class="detail-promises">
                    <div><span>↗</span><p><strong>Sendes raskt</strong><br />På lager · 2–4 virkedager</p></div>
                    <div><span>↺</span><p><strong>Enkel retur</strong><br />14 dager åpent kjøp</p></div>
                    <div><span>✦</span><p><strong>Trygg betaling</strong><br />Sikkert via Stripe</p></div>
                </div>
            </div>
        </section>

        <div class="detail-sticky-action" data-sticky-action hidden>
            <button class="primary-btn" type="button" aria-controls="detail-buy-form">
                Legg i handlekurv <span aria-hidden="true">→</span>
                <span class="detail-sticky-price">@Model.Product.Price.ToString("N0") kr</span>
            </button>
        </div>

        <section class="detail-story">
            <div><span class="section-kicker">Hvorfor vi valgte den</span><h2>Designet for å bli brukt.</h2></div>
            <p>Vi tror gode produkter skal gjøre hverdagen litt bedre uten å kreve oppmerksomhet. Derfor velger vi materialer, former og detaljer som tåler å brukes igjen og igjen.</p>
        </section>
    </div>
}
else
{
    <div class="product-detail-shell"><div class="empty-cart"><h2>Produktet finnes ikke</h2><a class="primary-btn" asp-page="/Index">Tilbake til butikken</a></div></div>
}