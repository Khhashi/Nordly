@page "{id:guid}"
@model DetailsModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Produkt";
}

@if (Model.Product is not null)
{
    var productImages = Model.Product.ImageUrls;
    <div class="product-detail-shell">
        <nav class="breadcrumb" aria-label="Brødsmulesti">
            <a asp-page="/Index">Butikk</a><span>/</span><span>@Model.Product.Category</span><span>/</span><strong>@Model.Product.Name</strong>
        </nav>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success action-toast" role="status"><span class="feedback-icon" aria-hidden="true">✓</span><span>@success</span><button class="toast-close" type="button" aria-label="Lukk melding">×</button></div>
        }

        <section class="product-detail-grid">
            <div class="detail-gallery-column" data-product-gallery>
                <div class="detail-image-panel">
                    <img id="product-main-image" data-gallery-main src="@productImages[0]" alt="@Model.Product.Name" />
                    <span class="detail-image-label">Studio collection / @Model.Product.Category</span>
                </div>
                @if (productImages.Count > 1)
                {
                    <div class="detail-gallery-thumbnails" role="group" aria-label="Produktbilder for @Model.Product.Name">
                        @for (var imageIndex = 0; imageIndex < productImages.Count; imageIndex++)
                        {
                            var imageUrl = productImages[imageIndex];
                            <button class="detail-gallery-thumbnail" type="button" data-gallery-thumbnail data-gallery-image="@imageUrl" data-gallery-alt="@Model.Product.Name – bilde @(imageIndex + 1)" aria-controls="product-main-image" aria-label="Vis bilde @(imageIndex + 1) av @productImages.Count" aria-pressed="@(imageIndex == 0 ? "true" : "false")">
                                <img src="@imageUrl" alt="" loading="lazy" decoding="async" />
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="product-detail-copy">
                <span class="eyebrow">@Model.Product.Category · Studio collection</span>
                <h1>@Model.Product.Name</h1>
                <p class="detail-price">@Model.Product.Price.ToString("N0") kr</p>
                <p class="detail-description">@Model.Product.Description</p>

                <form method="post" asp-page-handler="AddToCart" class="detail-buy-form" id="detail-buy-form">
                    <div class="quantity-control detail-stepper" role="group" aria-label="Antall">
                        <button class="quantity-btn remove-btn" type="button" data-step="-1" aria-label="Færre">−</button>
                        <input id="quantity" name="quantity" type="number" min="1" max="10" value="1" inputmode="numeric" aria-label="Antall" />
                        <button class="quantity-btn add-btn" type="button" data-step="1" aria-label="Flere">+</button>
                    </div>
                    <button class="primary-btn" type="submit">Legg i handlekurv <span aria-hidden="true">→</span></button>
                </form>

                <div class="detail-promises">
                    <div><span>↗</span><p><strong>Sendes raskt</strong><br />På lager · 2–4 virkedager</p></div>
                    <div><span>↺</span><p><strong>Enkel retur</strong><br />14 dager åpent kjøp</p></div>
                    <div><span>✦</span><p><strong>Trygg betaling</strong><br />Sikkert via Stripe</p></div>
                </div>
            </div>
        </section>

        @if (Model.Product.Specifications is { HasDetails: true } specifications)
        {
            <section class="product-specifications" aria-labelledby="product-specifications-title">
                <div>
                    <span class="section-kicker">Produktinformasjon</span>
                    <h2 id="product-specifications-title">Produktdetaljer</h2>
                </div>
                <div class="product-specifications-content">
                    <dl>
                        @if (!string.IsNullOrWhiteSpace(specifications.Material))
                        {
                            <div><dt>Materiale</dt><dd>@specifications.Material</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(specifications.Dimensions))
                        {
                            <div><dt>Mål</dt><dd>@specifications.Dimensions</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(specifications.CareInstructions))
                        {
                            <div><dt>Vedlikehold</dt><dd>@specifications.CareInstructions</dd></div>
                        }
                    </dl>
                    @if (specifications.Highlights?.Any(highlight => !string.IsNullOrWhiteSpace(highlight)) == true)
                    {
                        <ul aria-label="Produktegenskaper">
                            @foreach (var highlight in specifications.Highlights.Where(highlight => !string.IsNullOrWhiteSpace(highlight)))
                            {
                                <li>@highlight</li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        <div class="detail-sticky-action" data-sticky-action hidden>
            <button class="primary-btn" type="button" aria-controls="detail-buy-form">
                Legg i handlekurv <span aria-hidden="true">→</span>
                <span class="detail-sticky-price">@Model.Product.Price.ToString("N0") kr</span>
            </button>
        </div>

        <section class="detail-story">
            <div><span class="section-kicker">Hvorfor vi valgte den</span><h2>Designet for å bli brukt.</h2></div>
            <p>Vi tror gode produkter skal gjøre hverdagen litt bedre uten å kreve oppmerksomhet. Derfor velger vi materialer, former og detaljer som tåler å brukes igjen og igjen.</p>
        </section>

        @if (Model.RelatedProducts.Count > 0)
        {
            <section class="related-products" aria-labelledby="related-products-title">
                <div class="section-intro">
                    <span class="section-kicker">Mer å utforske · @Model.Product.Category</span>
                    <h2 id="related-products-title">Du liker kanskje også</h2>
                </div>
                <div class="product-grid related-product-grid">
                    @foreach (var relatedProduct in Model.RelatedProducts)
                    {
                        <article class="product-card">
                            <div class="product-image-wrap">
                                <a asp-page="/Products/Details" asp-route-id="@relatedProduct.Id" aria-label="Se detaljer for @relatedProduct.Name">
                                    <img class="product-image" src="@relatedProduct.ImageUrl" alt="@relatedProduct.Name" loading="lazy" decoding="async" />
                                </a>
                                <span class="product-category">@relatedProduct.Category</span>
                                @if (relatedProduct.Badge is not null)
                                {
                                    <span class="product-badge">@relatedProduct.Badge</span>
                                }
                            </div>
                            <div class="product-info">
                                <h3><a asp-page="/Products/Details" asp-route-id="@relatedProduct.Id">@relatedProduct.Name</a></h3>
                                <p>@relatedProduct.Description</p>
                                <div class="product-buy-row">
                                    <strong>@relatedProduct.Price.ToString("N0") kr</strong>
                                    <a class="text-link" asp-page="/Products/Details" asp-route-id="@relatedProduct.Id">Se produkt <span aria-hidden="true">→</span></a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}
else
{
    <div class="product-detail-shell"><div class="empty-cart"><h2>Produktet finnes ikke</h2><a class="primary-btn" asp-page="/Index">Tilbake til butikken</a></div></div>
}