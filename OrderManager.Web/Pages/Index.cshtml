@page
@model IndexModel
@{
	ViewData["Title"] = "Shop";
}

<div class="store-shell">
	<section class="store-hero">
		<div>
			<span class="eyebrow">Objects for everyday living</span>
			<h1>Færre ting.<br /><em>Bedre ting.</em></h1>
			<p>Gjennomtenkte objekter for hjemmet, skrivebordet og dagene imellom.</p>
		</div>
		<div class="hero-note"><span>01</span><span>Curated essentials<br />for a slower pace</span></div>
	</section>

	@if (TempData["Success"] is string success)
	{
		<div class="alert alert-success">@success <a asp-page="/Cart">Se handlekurv →</a></div>
	}

	<div class="catalog-header">
		<div>
			<span class="section-kicker">The collection</span>
			<h2>Utvalgte produkter</h2>
		</div>
		<span class="catalog-count">@Model.Products.Count produkter</span>
	</div>

	<section class="product-grid" aria-label="Produktkatalog">
		@foreach (var product in Model.Products)
		{
			<article class="product-card">
				<div class="product-image-wrap">
					<img class="product-image" src="@product.ImageUrl" alt="@product.Name" />
					<span class="product-category">@product.Category</span>
				</div>
				<div class="product-info">
					<div>
						<h3>@product.Name</h3>
						<p>@product.Description</p>
					</div>
					<div class="product-buy-row">
						<strong>@product.Price.ToString("N0") kr</strong>
						<form method="post" asp-page-handler="AddToCart">
							<input type="hidden" name="productId" value="@product.Id" />
							<button class="add-btn" type="submit" aria-label="Legg @product.Name i handlekurven">+</button>
						</form>
					</div>
				</div>
			</article>
		}
	</section>
</div>
