@page
@{
    ViewData["Title"] = "Levering og retur";
}

<div class="info-page">
    <span class="eyebrow">Praktisk info</span>
    <h1>Levering & retur</h1>
    <div class="info-content">
        <h2>Levering</h2>
        <p>Vi sender lagervarer innen én virkedag. Normal leveringstid er 2–4 virkedager.</p>
        <h2>Fri frakt</h2>
        <p>Du får fri frakt på ordre over 800 kr. Leveringskostnad vises før betaling.</p>
        <h2>Retur</h2>
        <p>Du har 14 dagers åpent kjøp. Kontakt oss før du sender varen tilbake, så hjelper vi deg videre.</p>
    </div>
</div>