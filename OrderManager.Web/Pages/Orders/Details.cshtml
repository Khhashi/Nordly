@page "{id:guid}"
@model DetailsModel
@{
    ViewData["Title"] = "Order details";
    ViewData["OrderId"] = Model.Id;
}

<div class="page-shell">
    <main class="container">
        <div class="hero">
            <span class="eyebrow">Order</span>
            <h1>Order details</h1>
        </div>

        <a class="secondary-btn back-link" asp-page="/Orders">← Back to orders</a>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (Model.Order != null)
        {
            <section class="panel details-panel">
                <div class="panel-header">
                    <h3>Order details</h3>
                    <span class="badge detail-badge">@Model.Order.Id</span>
                </div>

                <div class="detail-body">
                    <p><strong>Total:</strong> @Model.Order.GetTotal() kr</p>
                    <p><strong>Items:</strong> @Model.Order.OrderLines.Count</p>

                    @foreach (var line in Model.Order.OrderLines)
                    {
                        <div class="detail-line">
                            <span>@line.Product.Name</span>
                            <span>@line.Quantity x @line.Product.Price kr</span>
                        </div>
                    }
                </div>

                <form method="post" asp-page-handler="Update">
                    <div class="field-group">
                        <label asp-for="ProductName">Product name</label>
                        <input asp-for="ProductName" class="styled-input" />
                    </div>

                    <div class="field-group">
                        <label asp-for="Price">Price</label>
                        <input asp-for="Price" class="styled-input" type="number" step="0.01" min="0.01" />
                    </div>

                    <div class="field-group">
                        <label asp-for="Quantity">Quantity</label>
                        <input asp-for="Quantity" class="styled-input" type="number" min="1" />
                    </div>

                    <button type="submit" class="primary-btn">Update order</button>
                </form>

                <form method="post" asp-page-handler="Delete" class="delete-detail-form">
                    <button type="submit" class="danger-btn">Delete order</button>
                </form>
            </section>
        }
    </main>

    <footer class="footer">
        © 2026 - OrderManager
    </footer>
</div>
