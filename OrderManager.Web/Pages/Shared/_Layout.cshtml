<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NORDLY</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="announcement-bar">Fri frakt på ordre over 800 kr <span>•</span> Levering på 2–4 virkedager</div>
    @{
        var cartJson = Context.Session.GetString("cart");
        var cartCount = string.IsNullOrWhiteSpace(cartJson)
            ? 0
            : System.Text.Json.JsonSerializer.Deserialize<List<OrderManager.Web.Pages.CartItem>>(cartJson)?.Sum(item => item.Quantity) ?? 0;
    }
    <header class="topbar">
        <a class="brand" asp-page="/Index">NORDLY <span>STUDIO</span></a>
        <nav class="nav-links" aria-label="Main navigation">
            <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index">Shop</a>
            <a class="nav-optional" href="/#collection">Kolleksjon</a>
            <a class="nav-optional" href="/#new-arrivals">Nyheter</a>
            <a class="nav-optional" href="/#offers">Tilbud</a>
            <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Cart" ? "active" : "")" asp-page="/Cart">Cart <span class="nav-badge">@cartCount</span></a>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-brand"><strong>NORDLY</strong><span>Objects for everyday living.</span></div>
        <div class="footer-links"><a asp-page="/Info/Delivery">Levering & retur</a><a asp-page="/Info/Support">Kundeservice</a><a asp-page="/Privacy">Personvern</a><a asp-page="/Info/Terms">Vilkår</a></div>
        <div class="footer-payment"><span>Trygg betaling</span><strong>Stripe · Visa · Mastercard</strong></div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>