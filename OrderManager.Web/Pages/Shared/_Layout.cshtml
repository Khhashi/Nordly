<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrderManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OrderManager.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index">OrderManager <span>STUDIO</span></a>
        <nav class="nav-links" aria-label="Main navigation">
            <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index">Shop</a>
            <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Cart" ? "active" : "")" asp-page="/Cart">Cart</a>
            <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Orders" ? "active" : "")" asp-page="/Orders">Admin</a>
            @if (ViewData["OrderId"] is Guid orderId)
            {
                <a class="active" asp-page="/Orders/Details" asp-route-id="@orderId">Order details</a>
            }
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <span>OrderManager</span>
        <span>Enkel ordreoversikt for hverdagen</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>