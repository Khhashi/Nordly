@page
@model OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<div class="page-shell">
    <main class="container">
        <div class="hero">
            <div>
                <span class="eyebrow">Dagens oversikt</span>
                <h1>Hold orden på salget.</h1>
                <p class="hero-copy">Opprett, finn og oppdater ordre fra ett rolig arbeidsområde.</p>
            </div>
            <a class="hero-action" href="#create-order">+ Ny ordre</a>
        </div>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <section class="stats-grid" aria-label="Ordrestatistikk">
            <div class="stat-card">
                <span class="stat-label">Totale ordre</span>
                <strong>@Model.Orders.Count</strong>
                <span class="stat-hint">Registrert i systemet</span>
            </div>
            <div class="stat-card accent-teal">
                <span class="stat-label">Ordreverdi</span>
                <strong>@Model.Orders.Sum(order => order.GetTotal()).ToString("N2") kr</strong>
                <span class="stat-hint">Samlet verdi</span>
            </div>
            <div class="stat-card accent-amber">
                <span class="stat-label">Varer i ordre</span>
                <strong>@Model.Orders.Sum(order => order.OrderLines.Sum(line => line.Quantity))</strong>
                <span class="stat-hint">Totalt antall enheter</span>
            </div>
        </section>

        <section class="content-grid">
            <div class="panel form-panel" id="create-order">
                <div class="section-heading">
                    <span class="section-kicker">Kom i gang</span>
                    <h2>Opprett ordre</h2>
                    <p>Legg inn første varelinje. Flere linjer kan legges til senere.</p>
                </div>
                <form method="post" asp-page-handler="Create">
                    <div class="field-group">
                        <label asp-for="ProductName">Produktnavn</label>
                        <input asp-for="ProductName" class="styled-input" placeholder="For eksempel: Laptop" />
                    </div>

                    <div class="field-group">
                        <label asp-for="Price">Pris</label>
                        <input asp-for="Price" class="styled-input" type="number" step="0.01" min="0.01" value="0" />
                    </div>

                    <div class="field-group">
                        <label asp-for="Quantity">Antall</label>
                        <input asp-for="Quantity" class="styled-input" type="number" min="1" value="1" />
                    </div>

                    <button type="submit" class="primary-btn">Opprett ordre <span aria-hidden="true">→</span></button>
                </form>
            </div>

            <div class="panel list-panel">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Arbeidsflate</span>
                        <h2>Seneste ordre</h2>
                    </div>
                    <span class="badge">@Model.Orders.Count totalt</span>
                </div>

                @if (!Model.Orders.Any())
                {
                    <div class="empty-state">
                        <strong>Ingen ordre ennå</strong>
                        <p>Start med å opprette den første ordren din.</p>
                        <a class="secondary-btn" href="#create-order">Opprett første ordre</a>
                    </div>
                }
                else
                {
                    <div class="orders-list">
                        @foreach (var order in Model.Orders)
                        {
                            <div class="order-card">
                                <div class="order-topline">
                                    <div>
                                        <span class="order-label">ORDRE</span>
                                        <span class="order-id">@order.Id.ToString()[..8].ToUpperInvariant()</span>
                                    </div>
                                    <span class="order-total">@order.GetTotal() kr</span>
                                </div>
                                <div class="order-meta">
                                    <span class="status-dot"></span>
                                    <span>@order.OrderLines.Sum(line => line.Quantity) enheter</span>
                                    <span>•</span>
                                    <span>Aktiv</span>
                                </div>
                                <div class="order-actions">
                                    <a class="secondary-btn" asp-page="/Orders/Details" asp-route-id="@order.Id">Se detaljer <span aria-hidden="true">→</span></a>
                                    <form method="post" asp-page-handler="Delete" class="inline-form">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="danger-btn">Slett</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

    </main>

</div>
