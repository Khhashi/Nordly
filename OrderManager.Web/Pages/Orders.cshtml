@page
@model OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<div class="page-shell">
    <main class="container">
        <div class="hero">
            <span class="eyebrow">Operations</span>
            <h1>Order Manager</h1>
        </div>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <section class="content-grid">
            <div class="panel form-panel" id="create-order">
                <h3>Create order</h3>
                <form method="post" asp-page-handler="Create">
                    <div class="field-group">
                        <label asp-for="ProductName">Product name</label>
                        <input asp-for="ProductName" class="styled-input" placeholder="e.g. Laptop" />
                    </div>

                    <div class="field-group">
                        <label asp-for="Price">Price</label>
                        <input asp-for="Price" class="styled-input" type="number" step="0.01" min="0.01" value="0" />
                    </div>

                    <div class="field-group">
                        <label asp-for="Quantity">Quantity</label>
                        <input asp-for="Quantity" class="styled-input" type="number" min="1" value="1" />
                    </div>

                    <button type="submit" class="primary-btn">Create order</button>
                </form>
            </div>

            <div class="panel list-panel">
                <div class="panel-header">
                    <h3>Orders</h3>
                    <span class="badge">@Model.Orders.Count @(Model.Orders.Count == 1 ? "order" : "orders")</span>
                </div>

                @if (!Model.Orders.Any())
                {
                    <div class="empty-state">
                        <strong>No orders yet</strong>
                        <p>Create your first order to get started.</p>
                        <a class="secondary-btn" href="#create-order">Create an order</a>
                    </div>
                }
                else
                {
                    <div class="orders-list">
                        @foreach (var order in Model.Orders)
                        {
                            <div class="order-card">
                                <div class="order-topline">
                                    <span class="order-id">@order.Id</span>
                                    <span class="order-total">@order.GetTotal() kr</span>
                                </div>
                                <div class="order-meta">
                                    <span>@order.OrderLines.Count items</span>
                                </div>
                                <div class="order-actions">
                                    <a class="secondary-btn" asp-page="/Orders/Details" asp-route-id="@order.Id">View details</a>
                                    <form method="post" asp-page-handler="Delete" class="inline-form">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="danger-btn">Delete</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

    </main>

    <footer class="footer">
        © 2026 - OrderManager - Privacy
    </footer>
</div>
